# Uygulama yalnızca yerelde çalışır.
APP_NAME="AI Destekli İş Süreci Tahmin ve Gecikme Risk Sistemi"
DATABASE_PATH="data/process_risk.db"
MODEL_ARTIFACT_DIR="ml/artifacts"
# Sistem sağlığı izleme eşikleri (yalnızca yerel ölçüm ve kayıt).
SYSTEM_MONITOR_ENABLED="true"
SYSTEM_MONITOR_INTERVAL_SECONDS="60"
SYSTEM_CPU_WARNING_PERCENT="80"
SYSTEM_CPU_CRITICAL_PERCENT="95"
SYSTEM_MEMORY_WARNING_PERCENT="80"
SYSTEM_MEMORY_CRITICAL_PERCENT="90"
SYSTEM_DISK_WARNING_PERCENT="85"
SYSTEM_DISK_CRITICAL_PERCENT="95"
